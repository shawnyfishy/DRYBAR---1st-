# Canonical Website URL for OpenGraph, Metadata, Robots, and Sitemap
# If missing, defaults to 'https://drybar.qa'
NEXT_PUBLIC_SITE_URL=https://drybar.qa

# Primary Outbound Zenoti Booking Flow URL
# If missing, empty, or invalid, booking CTAs automatically fall back to pre-filled WhatsApp booking (+974 7773 0600) opening in a new tab
NEXT_PUBLIC_ZENOTI_BOOK_URL=https://drybarqatar.zenoti.com/book

# Guest Portal URL for Rescheduling & Managing Bookings
# If missing, empty, or invalid, manage CTAs automatically fall back to pre-filled WhatsApp reschedule contact (+974 7773 0600) opening in a new tab
NEXT_PUBLIC_ZENOTI_MANAGE_URL=https://drybarqatar.zenoti.com/manage

# Gewan Island Flagship Google Maps Pin URL
# If missing, falls back to default Gewan Island coordinates link on Google Maps
NEXT_PUBLIC_MAPS_URL=https://maps.google.com/?q=Gewan+Island+The+Pearl+Doha
